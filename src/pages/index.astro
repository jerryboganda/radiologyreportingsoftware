---
import '@fontsource-variable/inter/opsz.css';
import '../styles/global.css';
import ReportWorkspace from '../components/workspace/ReportWorkspace';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ECF0F6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#090D15" media="(prefers-color-scheme: dark)" />
    <title>PolytronX · Radiology Reporting</title>
    <link rel="icon" type="image/png" href="/assets/gmc_crest_300dpi.png" />
    <script is:inline>
      // Apply the saved theme before first paint (no flash). "system" follows the OS.
      (() => {
        let pref = 'system';
        try {
          pref = localStorage.getItem('theme') || 'system';
        } catch {}
        const dark = pref === 'dark' || (pref === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body class="h-dvh overflow-hidden">
    <Fragment set:html={`<!--
THESIS: The workspace is the live twin of the issued A4 report: what the resident edits is visibly what prints. Refuses the generic SaaS form-and-card editor.
OWN-WORLD: The PDF's institutional language (navy #0F2C59, cobalt #2563EB, two-cell stripe, organ chips, impression card) on cool slate; dark reading-room light box for the source note.
STORY: Photograph the senior's note; the AI drafts under AGENTS.md; the resident checks it against the note side by side and issues the PDF.
FIRST VIEWPORT: Case queue left; note light box centre; the report sheet right; Approve & download always top-right.
FORM: Inherited established world (locked print template), no concept roll; signature moment = scan beam over the note while the report develops section by section.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
-->`} />
    <ReportWorkspace client:only="react" />
  </body>
</html>
