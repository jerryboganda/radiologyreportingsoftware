---
import { db } from '../../db';
import { reports } from '../../db/schema';
import { eq } from 'drizzle-orm';
import { parseFindings } from '../../lib/report';
import { documentRef } from '../../lib/institution';
import { reportInstitution } from '../../lib/institutionStore';

const { id } = Astro.params;

if (!id) {
  return new Response('Report ID required', { status: 400 });
}

const result = await db.select().from(reports).where(eq(reports.id, id));
if (!result || result.length === 0) {
  return new Response('Report not found', { status: 404 });
}

const report = result[0];

// The letterhead and sign-off this case prints with: its own snapshot, so a later profile edit
// never rewrites an already-issued report.
const INSTITUTION = await reportInstitution(report);

// Never throws: malformed sections are dropped (the PDF route refuses a report without findings).
const findingsSections = parseFindings(report.findingsJson);

// One entry per line, without the "1." / "- " markers that the editor and the AI worker write.
const toLines = (markdown: string) => markdown
  .split('\n')
  .map(line => line.replace(/^\s*(?:[-*•]|\d+[.)])\s+/, '').trim())
  .filter(line => line.length > 0);
const impressionList = toLines(report.impressionMarkdown);
const recommendationsList = toLines(report.recommendationsMarkdown);

// AGENTS.md H13 / 11.2: a header variable missing from the source is printed as such, never invented.
const NOT_STATED = 'Not stated in source';
const stated = (value: string | null) => value?.trim() || NOT_STATED;
const ageGender = report.age.trim() || report.gender.trim() ? `${stated(report.age)} / ${stated(report.gender)}` : NOT_STATED;

// Screen-only bar. /api/pdf prints this page while the case is still DRAFT, so nothing here may reach print media.
const finalized = report.status === 'FINALIZED';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <!-- Phones fit the 794px page; desktop browsers and page.pdf ignore it. -->
  <meta name="viewport" content="width=830" />
  <title>{report.patientName} - #{report.tokenNumber} - GMCTH Radiology Report</title>
  <style is:inline>
    @page {
      size: A4 portrait;
      margin: 8mm 10mm 8mm 10mm;
    }
    @media print {
      html, body {
        margin: 0 !important;
        padding: 0 !important;
        background: #ffffff !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
      .a4-page {
        box-shadow: none !important;
        padding: 0 !important;
        margin: 0 !important;
        width: 100% !important;
      }
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      color: #0F172A;
      background: #E2E8F0;
      padding: 10px;
      line-height: 1.3;
      font-size: 10px;
    }

    .a4-page {
      width: 210mm;
      margin: 0 auto;
      background: #FFFFFF;
      padding: 6mm 10mm;
      position: relative;
    }

    /* HEADER */
    .header-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 4px;
    }
    .header-table td {
      vertical-align: middle;
    }
    .crest-img {
      width: 52px;
      height: 52px;
      object-fit: contain;
      display: block;
    }
    .inst-gov {
      font-size: 8px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-weight: 700;
      color: #64748B;
      margin-bottom: 1px;
      text-align: center;
    }
    .inst-title {
      font-size: 14px;
      font-weight: 900;
      color: #0F2C59;
      letter-spacing: -0.01em;
      text-align: center;
      margin-bottom: 1px;
    }
    .inst-sub {
      font-size: 10px;
      font-weight: 700;
      color: #1E293B;
      text-align: center;
      letter-spacing: 0.02em;
    }
    .inst-faculty {
      font-size: 8px;
      color: #475569;
      text-align: center;
      margin-top: 2px;
    }

    /* ACCENT STRIPE */
    .accent-stripe {
      display: table;
      width: 100%;
      height: 3px;
      margin-bottom: 8px;
    }
    .stripe-navy {
      display: table-cell;
      width: 70%;
      background-color: #0F2C59;
    }
    .stripe-cobalt {
      display: table-cell;
      width: 30%;
      background-color: #2563EB;
    }

    /* DEMOGRAPHICS TABLE */
    .meta-box {
      width: 100%;
      border: 1px solid #CBD5E1;
      border-radius: 4px;
      background: #F8FAFC;
      border-collapse: collapse;
      margin-bottom: 8px;
    }
    .meta-box td {
      padding: 3px 6px;
      font-size: 9.5px;
      vertical-align: top;
      border-bottom: 1px solid #E2E8F0;
    }
    .meta-label {
      color: #64748B;
      font-weight: 600;
      text-transform: uppercase;
      font-size: 8.5px;
      display: block;
      margin-bottom: 1px;
    }
    .meta-val {
      color: #0F172A;
      font-weight: 600;
      font-size: 10.5px;
    }
    .meta-token {
      color: #0F2C59;
      font-weight: 800;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 12px;
    }

    /* SECTION TITLES */
    .sec-header {
      font-size: 10.5px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #0F2C59;
      border-bottom: 1.5px solid #2563EB;
      padding-bottom: 2px;
      margin-top: 8px;
      margin-bottom: 6px;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
    }
    .sec-tag {
      font-size: 8px;
      color: #94A3B8;
      font-weight: 700;
      letter-spacing: 0.1em;
    }

    /* TECHNIQUE */
    .technique-text {
      font-size: 10px;
      color: #1E293B;
      line-height: 1.4;
      margin-bottom: 8px;
    }

    /* CRITICAL ALERT */
    .critical-alert {
      background-color: #FEF2F2;
      border: 1px solid #FECACA;
      border-left: 4px solid #DC2626;
      border-radius: 4px;
      padding: 6px 10px;
      margin: 8px 0;
    }
    .critical-badge {
      font-size: 9px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #991B1B;
      margin-bottom: 2px;
    }
    .critical-body {
      font-size: 10px;
      font-weight: 700;
      color: #7F1D1D;
    }
    .critical-log {
      font-size: 8.5px;
      color: #991B1B;
      font-style: italic;
      margin-top: 3px;
    }

    /* FINDINGS */
    .organ-group {
      margin-bottom: 6px;
      page-break-inside: avoid;
    }
    .organ-title {
      font-size: 9.5px;
      font-weight: 800;
      color: #0F2C59;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      background: #F1F5F9;
      padding: 2px 6px;
      border-radius: 2px;
      display: inline-block;
      margin-bottom: 2px;
    }
    .organ-list {
      list-style: none;
      padding-left: 4px;
    }
    .organ-item {
      position: relative;
      padding-left: 10px;
      margin-bottom: 2px;
      font-size: 10px;
      line-height: 1.35;
      color: #1E293B;
    }
    .organ-item::before {
      content: "•";
      position: absolute;
      left: 0;
      color: #2563EB;
      font-weight: bold;
    }
    .organ-item strong {
      color: #0F172A;
      font-weight: 700;
    }
    .organ-item.abnormal span {
      font-weight: 600;
      color: #020617;
    }

    /* EXECUTIVE IMPRESSION CARD */
    .card-impression {
      border: 1px solid #CBD5E1;
      border-left: 4px solid #0F2C59;
      background: #F8FAFC;
      border-radius: 4px;
      padding: 8px 12px;
      margin: 8px 0;
      page-break-inside: avoid;
    }
    .card-title {
      font-size: 10px;
      font-weight: 800;
      color: #0F2C59;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 4px;
    }
    .impression-ol {
      padding-left: 14px;
      margin-bottom: 6px;
    }
    .impression-ol li {
      font-size: 10px;
      font-weight: 600;
      color: #0F172A;
      margin-bottom: 2px;
      line-height: 1.35;
    }
    .rec-divider {
      border-top: 1px solid #E2E8F0;
      padding-top: 4px;
      margin-top: 4px;
    }
    .rec-title {
      font-size: 8.5px;
      font-weight: 800;
      text-transform: uppercase;
      color: #2563EB;
      letter-spacing: 0.08em;
      margin-bottom: 1px;
    }
    .rec-body {
      font-size: 9.5px;
      color: #1E293B;
      font-weight: 500;
      line-height: 1.35;
    }

    /* FOOTER & SIGNATURES */
    .footer-block {
      page-break-inside: avoid;
      margin-top: 8px;
    }
    .sig-table {
      width: 100%;
      border-collapse: collapse;
      border-top: 1px solid #CBD5E1;
      padding-top: 6px;
      margin-bottom: 4px;
    }
    .sig-table td {
      vertical-align: top;
      font-size: 9.5px;
      padding-top: 6px;
    }
    .sig-col-left {
      width: 50%;
      border-right: 1px solid #E2E8F0;
      padding-right: 12px;
    }
    .sig-col-right {
      width: 50%;
      text-align: right;
      padding-left: 12px;
    }
    .sig-head {
      font-size: 8px;
      font-weight: 800;
      text-transform: uppercase;
      color: #64748B;
      letter-spacing: 0.08em;
      margin-bottom: 3px;
    }
    .sig-doc {
      color: #0F172A;
      font-weight: 700;
      margin-bottom: 1px;
    }
    .sig-sub {
      color: #64748B;
      font-size: 8.5px;
      font-weight: 500;
    }
    .sig-hod {
      font-size: 11px;
      font-weight: 900;
      color: #0F2C59;
    }

    .doc-footer {
      border-top: 1px solid #E2E8F0;
      padding-top: 4px;
      display: flex;
      justify-content: space-between;
      font-size: 8px;
      color: #94A3B8;
    }

    /* SCREEN PREVIEW ONLY: the canvas, the lifted A4 sheet and the bar. Print media never sees any of it. */
    @media print {
      .screen-bar { display: none !important; }
    }
    @media screen {
      body {
        background: #ECF0F6;
        padding: 0;
      }
      .a4-page {
        margin: 32px auto 48px;
        min-height: 297mm;
        display: flex;
        flex-direction: column;
        border-radius: 6px;
        box-shadow: 0 0 0 1px rgb(226 232 240 / 0.7), 0 1px 1px rgb(15 23 42 / 0.05), 0 10px 30px -12px rgb(15 23 42 / 0.16);
      }
      .a4-page > .footer-block {
        margin-top: auto;
      }
      .screen-bar {
        position: sticky;
        top: 0;
        z-index: 10;
        height: 48px;
        padding: 0 16px;
        background: rgb(255 255 255 / 0.92);
        -webkit-backdrop-filter: blur(8px);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid #E1E7EF;
        font-family: "Inter Variable", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        font-size: 13px;
        line-height: 1;
        color: #0F172A;
      }
      .screen-bar-inner {
        max-width: 210mm;
        height: 100%;
        margin: 0 auto;
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .screen-bar-name {
        min-width: 0;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
        font-size: 14px;
        font-weight: 600;
      }
      .screen-bar-token {
        flex-shrink: 0;
        color: #546277;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 12px;
      }
      .screen-bar-pill {
        flex-shrink: 0;
        height: 24px;
        padding: 0 9px;
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        color: #B45309;
        background: #FDF3E4;
      }
      .screen-bar-pill.is-final {
        color: #047857;
        background: #E6F5EE;
      }
      .screen-bar-spacer {
        flex: 1;
      }
      .screen-bar button {
        flex-shrink: 0;
        height: 32px;
        padding: 0 12px;
        border-radius: 8px;
        border: 1px solid #E1E7EF;
        background: #FFFFFF;
        color: #0F172A;
        font: inherit;
        font-weight: 500;
        cursor: pointer;
      }
      .screen-bar button:hover {
        background: #F1F5F9;
      }
      .screen-bar button.is-primary {
        border-color: #0F2C59;
        background: #0F2C59;
        color: #FFFFFF;
      }
      .screen-bar button.is-primary:hover {
        background: rgb(15 44 89 / 0.9);
      }
      .screen-bar button:focus-visible {
        outline: 2px solid #2563EB;
        outline-offset: 2px;
      }
    }
  </style>
</head>
<body>
  <div class="screen-bar">
    <div class="screen-bar-inner">
      <span class="screen-bar-name" title={report.patientName.trim() || 'Untitled note'}>{report.patientName.trim() || 'Untitled note'}</span>
      {report.tokenNumber.trim() && <span class="screen-bar-token">#{report.tokenNumber.trim()}</span>}
      <span class:list={['screen-bar-pill', { 'is-final': finalized }]}>{finalized ? 'Finalized' : 'Draft · not issued'}</span>
      <span class="screen-bar-spacer"></span>
      {/* Drafts are issued only through Approve & download (the wording gate), so only a finalized report offers Print. */}
      {finalized && <button type="button" class="is-primary" onclick="window.print()">Print</button>}
      <button type="button" onclick="window.close(); setTimeout(() => { if (!window.closed) history.back(); }, 150);">Close</button>
    </div>
  </div>
  <div class="a4-page">
    <!-- BODY WRAPPER -->
    <div>
      <!-- TOP HEADER WITH VECTOR CRESTS -->
      <table class="header-table">
        <tr>
          <td style="width: 65px;">
            <img src="/assets/gmc_crest_300dpi.png" alt="GMC Crest" class="crest-img" />
          </td>
          <td>
            <div class="inst-gov">
              {INSTITUTION.government.toUpperCase()}
            </div>
            <div class="inst-title">
              {INSTITUTION.department.toUpperCase()}
            </div>
            <div class="inst-sub">
              {INSTITUTION.hospital.toUpperCase()}
            </div>
            <div class="inst-faculty">
              <strong>HOD:</strong> {INSTITUTION.hod} &nbsp;•&nbsp; <strong>Senior Registrars:</strong> {INSTITUTION.seniorRegistrars}
            </div>
          </td>
          <td style="width: 65px; text-align: right;">
            <img src="/assets/gth_crest_300dpi.png" alt="GTH Crest" class="crest-img" style="margin-left: auto;" />
          </td>
        </tr>
      </table>

      <!-- 2-CELL ACCENT STRIPE -->
      <div class="accent-stripe">
        <div class="stripe-navy"></div>
        <div class="stripe-cobalt"></div>
      </div>

      <!-- STRUCTURED DEMOGRAPHICS CARD (shadcn aesthetic) -->
      <table class="meta-box">
        <tr>
          <td style="width: 32%;">
            <span class="meta-label">Patient Name</span>
            <span class="meta-val" style="text-transform: uppercase;">{stated(report.patientName)}</span>
          </td>
          <td style="width: 22%;">
            <span class="meta-label">Token / Radiology ID</span>
            <span class="meta-token">{report.tokenNumber.trim() ? `#${report.tokenNumber}` : NOT_STATED}</span>
          </td>
          <td style="width: 22%;">
            <span class="meta-label">Age / Gender</span>
            <span class="meta-val">{ageGender}</span>
          </td>
          <td style="width: 24%;">
            <span class="meta-label">Date of Exam</span>
            <span class="meta-val">{stated(report.studyDate)}</span>
          </td>
        </tr>
        <tr>
          <td colspan="2">
            <span class="meta-label">Modality & Protocol</span>
            <span class="meta-val" style="color: #0F2C59;">{stated(report.modality)}</span>
          </td>
          <td>
            <span class="meta-label">Reporting Date</span>
            <span class="meta-val">{report.reportingDate}</span>
          </td>
          <td>
            <span class="meta-label">Referring Clinician</span>
            <span class="meta-val" style="font-size: 9.5px;">{stated(report.referringClinician)}</span>
          </td>
        </tr>
        <tr>
          <td colspan="3" style="border-bottom: none;">
            <span class="meta-label">Clinical Indication</span>
            <span style="font-size: 9.5px; color: #334155; font-style: italic;">{stated(report.clinicalHistory)}</span>
          </td>
          <td style="border-bottom: none; text-align: right;">
            <span class="meta-label">Comparison</span>
            <span style="font-size: 9px; color: #64748B;">{stated(report.comparison)}</span>
          </td>
        </tr>
      </table>

      <!-- TECHNIQUE -->
      <div style="margin-bottom: 6px;">
        <div class="sec-header">
          <span>Technique</span>
          <span class="sec-tag">Acquisition Parameters</span>
        </div>
        <p class="technique-text">{report.technique}</p>
      </div>

      <!-- CRITICAL ALERT (conditional) -->
      {report.isUrgent && report.urgentFindings?.trim() && (
        <div class="critical-alert">
          <div class="critical-badge">⚠ Critical Clinical Notification</div>
          <div class="critical-body">{report.urgentFindings}</div>
          {report.urgentCallLog && (
            <div class="critical-log">{report.urgentCallLog}</div>
          )}
        </div>
      )}

      <!-- STRUCTURED FINDINGS (RadLex organ hierarchy) -->
      <div style="margin-bottom: 6px;">
        <div class="sec-header">
          <span>Findings</span>
          <span class="sec-tag">RadLex Organ Grouping</span>
        </div>
        <div class="findings-container">
          {findingsSections.map((sec) => (
            <div class="organ-group">
              <div class="organ-title">{sec.title}</div>
              <ul class="organ-list">
                {sec.items.map((item) => (
                  <li class={`organ-item ${item.isAbnormal ? 'abnormal' : ''}`}>
                    <strong>{item.structure}: </strong>
                    <span>{item.content}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <!-- EXECUTIVE IMPRESSION & ACTIONABLE RECOMMENDATIONS CARD -->
      <div class="card-impression">
        <div class="card-title">Impression</div>
        <ol class="impression-ol">
          {impressionList.map((item) => (
            <li>{item}</li>
          ))}
        </ol>
        <div class="rec-divider">
          <div class="rec-title">Recommendations</div>
          <div class="rec-body">
            {recommendationsList.length > 0
              ? recommendationsList.map((item) => <div>{item}</div>)
              : 'Clinical correlation is advised.'}
          </div>
        </div>
      </div>
    </div>

    <!-- SIGNATURES AND FOOTER (Always at bottom) -->
    <div class="footer-block">
      <table class="sig-table">
        <tr>
          <td class="sig-col-left">
            <div class="sig-head">Primary Reporting Radiologists</div>
            {INSTITUTION.reportingRadiologists.map((doc) => (
              <div class="sig-doc">{doc.name} <span class="sig-sub">— {doc.qualification}</span></div>
            ))}
          </td>
          <td class="sig-col-right">
            <div class="sig-head">Reviewed & Approved By (Consultants)</div>
            <div class="sig-hod">{INSTITUTION.hod}</div>
            <div class="sig-sub" style="font-weight: 700; color: #1E293B;">{INSTITUTION.hodQualification}</div>
            <div class="sig-sub" style="margin-top: 2px;">{INSTITUTION.seniorRegistrars} (Senior Registrars)</div>
          </td>
        </tr>
      </table>

      <div class="doc-footer">
        <span>{INSTITUTION.footer}</span>
        <span style="font-family: ui-monospace, monospace;">Document Ref: {documentRef(report.tokenNumber, report.id)}</span>
      </div>
    </div>
  </div>
</body>
</html>
